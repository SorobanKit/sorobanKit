{
  "name": "stellar-payment-platform",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "tsx watch server.js",
    "test": "jest --forceExit --maxWorkers=2",
    "test:coverage": "jest --coverage --forceExit --maxWorkers=2",
    "test:memory": "node --expose-gc node_modules/.bin/jest --forceExit --testPathPattern=memory --globals '{\"gc\":true}'",
    "test:integration": "TEST_API_URL=http://localhost:5001 jest --forceExit --testPathPattern=integration",
    "test:load": "artillery run artillery.yml",
    "listener": "node horizonListener.js",
    "db:seed": "node scripts/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "contract:build": "node ../scripts/deploy.js build",
    "contract:deploy": "node ../scripts/deploy.js deploy",
    "contract:upgrade": "node ../scripts/deploy.js upgrade"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": false,
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "json-summary"],
    "coverageThreshold": {
      "global": {
        "statements": 78,
        "branches": 68,
        "functions": 78,
        "lines": 78
      }
    },
    "setupFiles": ["./jest.setup.js"]
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.47.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/exporter-zipkin": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@prisma/client": "^6.19.3",
    "@prisma/instrumentation": "^6.19.3",
    "@sentry/node": "^10.68.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "bad-words": "^3.0.4",
    "bullmq": "^5.58.5",
    "compression": "^1.8.1",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.7.0",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "4.5.0",
    "opossum": "^10.0.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "uuid": "^9.0.1",
    "xss": "^1.0.15",
    "zod": "^4.4.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "tsx": "4.23.1"
  }
}